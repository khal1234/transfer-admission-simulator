# Target-exclude local build & dependency directories
node_modules/
dist/
/data/

# Python compiled cache
*.pyc
__pycache__/

# Private agent configurations & keys
.gemini/
.env
*.key

# Claude Code — 공유하는 것은 settings.json 과 hooks/ 뿐이다.
# 아래는 이 기계에만 해당하는 것이라 올리지 않는다 (`*.local` 로는 안 걸린다).
.claude/settings.local.json
.claude/worktrees/
.claude/공용시스템-판정.md
저점-면제.txt
# 훅이 만드는 로컬 상태(.shared-system.lock 등)는 열거하지 않고 기본값을 막는 쪽으로 둔다 —
# 열거하면 훅이 파일을 하나 더 만들 때마다 샌다.
/.claude/hooks/.*

# Standard OS metadata & editor assets
.DS_Store
Thumbs.db
.vscode/
.idea/
*.local

# Local Netlify folder
.netlify

# Local scratch & tool logs
scratchpad/
tools/*.log
