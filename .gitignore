# Target-exclude local build & dependency directories
node_modules/
dist/
/data/

# Python compiled cache
*.pyc
__pycache__/

# Private agent configurations & keys
.gemini/
.env
*.key

# Claude Code — 공유하는 것은 settings.json 과 hooks/ 뿐이다.
# 아래는 이 기계에만 해당하는 것이라 올리지 않는다 (`*.local` 로는 안 걸린다).
.claude/settings.local.json
.claude/shared-system.lock
.claude/worktrees/

# Standard OS metadata & editor assets
.DS_Store
Thumbs.db
.vscode/
.idea/
*.local

# Local Netlify folder
.netlify

# Local scratch & tool logs
scratchpad/
tools/*.log
